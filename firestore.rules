rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidArtistName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 50
        && name.matches('^[a-zA-Z0-9\\s\\-_]+$');
    }

    function isValidConversationTitle(title) {
      return title is string
        && title.size() >= 1
        && title.size() <= 100
        && title.matches('^[a-zA-Z0-9\\s\\-_]+$');
    }

    function isValidDisplayName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 30
        && name.matches('^[a-zA-Z0-9\\s\\-_]+$');
    }

    function artistDoc(artistId) {
      return get(/databases/$(database)/documents/artists/$(artistId)).data;
    }

    function songDoc(songId) {
      return get(/databases/$(database)/documents/songs/$(songId)).data;
    }

    function isArtistOwner(artistId) {
      return signedIn()
        && exists(/databases/$(database)/documents/artists/$(artistId))
        && artistDoc(artistId).ownerId == request.auth.uid;
    }

    function isSongOwner(songId) {
      return signedIn()
        && exists(/databases/$(database)/documents/songs/$(songId))
        && songDoc(songId).ownerId == request.auth.uid;
    }

    // Public song, or the signed-in owner. Child queries must equality-filter
    // the parent id so this lookup is the same for every candidate document.
    function canReadSong(songId) {
      return exists(/databases/$(database)/documents/songs/$(songId))
        && (songDoc(songId).isPublic == true || isOwner(songDoc(songId).ownerId));
    }

    function canReadArtist(artistId) {
      return exists(/databases/$(database)/documents/artists/$(artistId))
        && (artistDoc(artistId).isPublic == true || isOwner(artistDoc(artistId).ownerId));
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Coins and X connection state are server-owned after create.
    // Create may only store an unlaunched coin and a disconnected X profile.
    function coinUnlaunched() {
      return !('pumpFun' in request.resource.data)
        || request.resource.data.pumpFun == null
        || (
          request.resource.data.pumpFun.mint == null
          && request.resource.data.pumpFun.url == null
          && request.resource.data.pumpFun.symbol == null
          && request.resource.data.pumpFun.creatorWallet == null
          && request.resource.data.pumpFun.launchedAt == null
        );
    }

    function xInactive() {
      return !('x' in request.resource.data)
        || request.resource.data.x == null
        || (
          request.resource.data.x.status == 'disconnected'
          && request.resource.data.x.username == null
          && request.resource.data.x.userId == null
          && request.resource.data.x.posts.size() == 0
          && request.resource.data.x.recentPostTexts.size() == 0
        );
    }

    // diff() throws a null-value error on maps that store nulls (pumpFun, x,
    // coverProvider). Compare the server-owned leaves instead.
    // Do not compare these maps with == or !=. Maps that store nulls throw.
    function samePumpFun() {
      return (!('pumpFun' in resource.data) && !('pumpFun' in request.resource.data))
        || (
          'pumpFun' in resource.data
          && 'pumpFun' in request.resource.data
          && request.resource.data.pumpFun.mint == resource.data.pumpFun.mint
          && request.resource.data.pumpFun.url == resource.data.pumpFun.url
          && request.resource.data.pumpFun.symbol == resource.data.pumpFun.symbol
          && request.resource.data.pumpFun.creatorWallet == resource.data.pumpFun.creatorWallet
          && request.resource.data.pumpFun.launchedAt == resource.data.pumpFun.launchedAt
        );
    }

    function sameX() {
      return (!('x' in resource.data) && !('x' in request.resource.data))
        || (
          'x' in resource.data
          && 'x' in request.resource.data
          && request.resource.data.x.status == resource.data.x.status
          && request.resource.data.x.username == resource.data.x.username
          && request.resource.data.x.userId == resource.data.x.userId
          && request.resource.data.x.connectedAt == resource.data.x.connectedAt
          && request.resource.data.x.pausedAt == resource.data.x.pausedAt
          && request.resource.data.x.lastError == resource.data.x.lastError
          && request.resource.data.x.lastErrorAt == resource.data.x.lastErrorAt
          && request.resource.data.x.profileSyncedAt == resource.data.x.profileSyncedAt
          && request.resource.data.x.posts.hasAll(resource.data.x.posts)
          && resource.data.x.posts.hasAll(request.resource.data.x.posts)
          && request.resource.data.x.recentPostTexts.hasAll(resource.data.x.recentPostTexts)
          && resource.data.x.recentPostTexts.hasAll(request.resource.data.x.recentPostTexts)
        );
    }

    function bothAbsentOrEqualTokenMint() {
      return (!('tokenMintAddress' in resource.data) && !('tokenMintAddress' in request.resource.data))
        || (
          'tokenMintAddress' in resource.data
          && 'tokenMintAddress' in request.resource.data
          && request.resource.data.tokenMintAddress == resource.data.tokenMintAddress
        );
    }

    function bothAbsentOrEqualTokenAt() {
      return (!('tokenMintCreatedAt' in resource.data) && !('tokenMintCreatedAt' in request.resource.data))
        || (
          'tokenMintCreatedAt' in resource.data
          && 'tokenMintCreatedAt' in request.resource.data
          && request.resource.data.tokenMintCreatedAt == resource.data.tokenMintCreatedAt
        );
    }

    function bothAbsentOrEqualDuration() {
      return (!('duration' in resource.data) && !('duration' in request.resource.data))
        || (
          'duration' in resource.data
          && 'duration' in request.resource.data
          && request.resource.data.duration == resource.data.duration
        );
    }

    // Missing on both sides, or present on both and equal.
    // Do not use this for maps that store nulls (pumpFun, x).
    function fieldUnchanged(field) {
      return (!(field in resource.data) && !(field in request.resource.data))
        || (
          field in resource.data
          && field in request.resource.data
          && request.resource.data[field] == resource.data[field]
        );
    }

    function sameCoverProvider() {
      return (
        (!('coverProvider' in resource.data) || resource.data.coverProvider == null)
        && (!('coverProvider' in request.resource.data) || request.resource.data.coverProvider == null)
      ) || (
        resource.data.coverProvider != null
        && request.resource.data.coverProvider != null
        && request.resource.data.coverProvider.posterModel == resource.data.coverProvider.posterModel
        && request.resource.data.coverProvider.loopModel == resource.data.coverProvider.loopModel
        && request.resource.data.coverProvider.posterRequestId == resource.data.coverProvider.posterRequestId
        && request.resource.data.coverProvider.loopRequestId == resource.data.coverProvider.loopRequestId
      );
    }

    function artistProfileUpdate() {
      return isOwner(resource.data.ownerId)
        && isValidArtistName(request.resource.data.name)
        && request.resource.data.nameLowercase == request.resource.data.name.lower()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.deletedAt == null
        && samePumpFun()
        && sameX()
        && fieldUnchanged('coinMetadataId')
        && fieldUnchanged('coinImagePath');
    }

    function songServerFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.parentSongId == resource.data.parentSongId
        && request.resource.data.collaborationType == resource.data.collaborationType
        && request.resource.data.albumCoverPath == resource.data.albumCoverPath
        && request.resource.data.albumCoverThumbnail == resource.data.albumCoverThumbnail
        && request.resource.data.coverPosterUrl == resource.data.coverPosterUrl
        && request.resource.data.coverVideoUrl == resource.data.coverVideoUrl
        && request.resource.data.coverMotionStatus == resource.data.coverMotionStatus
        && request.resource.data.coverMotionError == resource.data.coverMotionError
        && request.resource.data.coverUpdatedAt == resource.data.coverUpdatedAt
        && bothAbsentOrEqualTokenMint()
        && bothAbsentOrEqualTokenAt()
        && bothAbsentOrEqualDuration()
        && sameCoverProvider()
        && request.resource.data.keys().hasOnly([
          'id',
          'ownerId',
          'artistId',
          'artistVersionId',
          'title',
          'isPublic',
          'createdAt',
          'updatedAt',
          'deletedAt',
          'currentVersionId',
          'parentSongId',
          'collaborationType',
          'albumCoverPath',
          'albumCoverThumbnail',
          'coverPosterUrl',
          'coverVideoUrl',
          'coverMotionStatus',
          'coverMotionError',
          'coverUpdatedAt',
          'coverProvider',
          'playCount',
          'playsBySource',
          'playsBackground',
          'duration',
          'tokenMintAddress',
          'tokenMintCreatedAt'
        ]);
    }

    function songOwnerUpdate() {
      return isOwner(resource.data.ownerId)
        && songServerFieldsUnchanged()
        && fieldUnchanged('playCount')
        && fieldUnchanged('playsBySource')
        && fieldUnchanged('playsBackground')
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.isPublic is bool;
    }

    function songCreateClean() {
      return (!('playCount' in request.resource.data) || request.resource.data.playCount == 0)
        && !('playsBySource' in request.resource.data)
        && !('playsBackground' in request.resource.data)
        && (!('coverPosterUrl' in request.resource.data) || request.resource.data.coverPosterUrl == null)
        && (!('coverVideoUrl' in request.resource.data) || request.resource.data.coverVideoUrl == null)
        && (!('coverMotionStatus' in request.resource.data) || request.resource.data.coverMotionStatus == null)
        && (!('albumCoverPath' in request.resource.data) || request.resource.data.albumCoverPath == null)
        && (!('albumCoverThumbnail' in request.resource.data) || request.resource.data.albumCoverThumbnail == null)
        && (!('tokenMintAddress' in request.resource.data) || request.resource.data.tokenMintAddress == null)
        && (!('tokenMintCreatedAt' in request.resource.data) || request.resource.data.tokenMintCreatedAt == null);
    }

    function coinMetadataClean() {
      return (!('coinMetadataId' in request.resource.data) || request.resource.data.coinMetadataId == null)
        && (!('coinImagePath' in request.resource.data) || request.resource.data.coinImagePath == null);
    }

    match /users/{uid} {
      // Profile reads are public (display names on songs, comments, chat).
      // email and solanaWalletAddress live on the same document; rules cannot hide them.
      // Held: a later change may make this doc owner-only and move public fields
      // to publicProfiles/{uid}. That design is not implemented.
      allow get: if true;
      // Prefix search: where displayName >= q AND displayName <= q+\uf8ff.
      allow list: if resource.data.displayName is string;

      allow create: if isOwner(uid)
        && request.resource.data.deletedAt == null
        && (
          !('displayName' in request.resource.data)
          || request.resource.data.displayName == null
          || isValidDisplayName(request.resource.data.displayName)
        );

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'updatedAt',
          'solanaWalletAddress',
          'photoURL'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
          || isValidDisplayName(request.resource.data.displayName)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['solanaWalletAddress'])
          || request.resource.data.solanaWalletAddress == null
          || (
            request.resource.data.solanaWalletAddress is string
            && request.resource.data.solanaWalletAddress.size() >= 32
            && request.resource.data.solanaWalletAddress.size() <= 44
          )
        );

      // In-app account deletion (mobile). Web soft-deletes are not used on users.
      allow delete: if isOwner(uid);
    }

    match /artists/{artistId} {
      allow get: if resource.data.isPublic == true || isOwner(resource.data.ownerId);
      // Every list must constrain isPublic == true or ownerId == request.auth.uid.
      // Name search and mint lookup are public-only unless the caller is the owner.
      allow list: if resource.data.isPublic == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.id == artistId
        && isValidArtistName(request.resource.data.name)
        && request.resource.data.nameLowercase == request.resource.data.name.lower()
        && request.resource.data.deletedAt == null
        && request.resource.data.isPublic is bool
        && coinUnlaunched()
        && xInactive()
        && coinMetadataClean();

      allow update: if artistProfileUpdate();

      // Owner hard-delete for in-app account deletion. ownerId is fixed at create.
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /artistVersions/{versionId} {
      allow read: if canReadArtist(resource.data.artistId);
      allow create: if signedIn()
        && request.resource.data.id == versionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.artistId is string
        && isArtistOwner(request.resource.data.artistId);
      // Owner may update a version. createdBy is the ownership field and cannot change.
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /songs/{songId} {
      allow get: if resource.data.isPublic == true || isOwner(resource.data.ownerId);
      allow list: if resource.data.isPublic == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == songId
        && request.resource.data.artistId is string
        && isArtistOwner(request.resource.data.artistId)
        && request.resource.data.deletedAt == null
        && request.resource.data.isPublic is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && songCreateClean();

      // Plays are server-owned. Clients cannot bump playCount, playsBySource, or playsBackground.
      allow update: if songOwnerUpdate();

      // Owner hard-delete for in-app account deletion.
      // Web deleteSong soft-deletes via update of deletedAt.
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /songVersions/{versionId} {
      allow read: if canReadSong(resource.data.songId);
      // Clients may open a silent version. Audio URLs are written by the
      // server (Admin SDK) when a MusicGPT job finishes.
      allow create: if signedIn()
        && request.resource.data.id == versionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.songId is string
        && request.resource.data.audioURL == null
        && request.resource.data.providerOutputId == null
        && isSongOwner(request.resource.data.songId);
      allow update: if isSongOwner(resource.data.songId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPrimary'])
        && request.resource.data.isPrimary is bool
        && request.resource.data.audioURL == resource.data.audioURL
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // The browser may record a pending job for a song it owns.
    // Output audio URLs are not client-writable. The song owner may update other fields.
    match /generations/{generationId} {
      allow read: if canReadSong(resource.data.songId);
      allow create: if signedIn()
        && request.resource.data.id == generationId
        && request.resource.data.songId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.completedAt == null
        && request.resource.data.contentHash == null
        && request.resource.data.output.audioURL == null
        && request.resource.data.output.stems == null
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid)
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid)
        && isSongOwner(request.resource.data.songId);
      // Song owner may update a job. Audio URLs on output stay server-owned.
      allow update: if isSongOwner(resource.data.songId)
        && request.resource.data.songId == resource.data.songId
        && request.resource.data.id == resource.data.id
        && fieldUnchanged('ownerId')
        && fieldUnchanged('createdBy')
        && request.resource.data.output.audioURL == resource.data.output.audioURL
        && request.resource.data.output.stems == resource.data.output.stems;
      allow delete: if false;
    }

    match /collaborations/{collaborationId} {
      allow get: if true;
      allow list: if resource.data.sourceSongId is string;
      allow create: if signedIn()
        && request.resource.data.id == collaborationId
        && request.resource.data.collaboratorId == request.auth.uid
        && request.resource.data.sourceSongId is string
        && request.resource.data.targetSongId is string
        && request.resource.data.type in ['fork', 'remix', 'response', 'extension'];
      allow update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.id == followId
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.artistId is string;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || isSongOwner(resource.data.songId)
      );
      // Recipients mark read. The song owner soft-deletes notifications for that song.
      // Creating notifications is server-owned (generation complete).
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true
        ) || (
          isSongOwner(resource.data.songId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
        )
      );
      allow create, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && request.resource.data.type in ['direct', 'group']
        && (request.resource.data.type != 'direct' || request.resource.data.participants.size() == 2)
        && (
          !('createdBy' in request.resource.data)
          || request.resource.data.createdBy == request.auth.uid
        );
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageAt',
            'lastMessagePreview',
            'updatedAt'
          ])
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt'])
            && (request.resource.data.title == null || isValidConversationTitle(request.resource.data.title))
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.type == resource.data.type
          )
          || (
            resource.data.type == 'group'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt'])
            && request.resource.data.type == resource.data.type
            && request.resource.data.participants.size() >= 1
          )
        );
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isConversationParticipant(resource.data.conversationId);
      allow create: if signedIn()
        && request.resource.data.id == messageId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.deletedAt == null
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.auth.uid in request.resource.data.readBy
        && isConversationParticipant(request.resource.data.conversationId);
      allow update: if isConversationParticipant(resource.data.conversationId) && (
        (
          request.auth.uid == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasOnly(resource.data.readBy.concat([request.auth.uid]))
        )
      );
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if resource.data.deletedAt == null;
      allow create: if signedIn()
        && request.resource.data.id == commentId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.deletedAt == null
        && request.resource.data.targetType in ['artist', 'song']
        && request.resource.data.targetId is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content',
          'updatedAt',
          'deletedAt'
        ]);
      allow delete: if false;
    }

    // Feature kill switch. Public read so mobile can load it before sign-in.
    // This document only. Clients cannot write (Admin SDK / console only).
    match /config/mobile {
      allow read: if true;
      allow write: if false;
    }

    // X OAuth tokens and song-live idempotency. Admin SDK only.
    match /artistXAuth/{artistId} {
      allow read, write: if false;
    }
    match /xSongPosts/{songId} {
      allow read, write: if false;
    }
    // Pending coin metadata. TTL deletes coinUploads/{id} via expireAt.
    // Admin SDK only, including every nested coinUploads doc.
    match /coinMetadataUploads/{uid} {
      allow read, write: if false;
      match /coinUploads/{uploadId} {
        allow read, write: if false;
      }
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Anonymous play-count rate limits. Doc ids are HMACs. Admin SDK only.
    match /playRateLimits/{limitId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
